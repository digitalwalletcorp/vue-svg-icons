{
  "name": "@digitalwalletcorp/vue-svg-icons",
  "version": "1.0.0",
  "description": "Original SVG icons for Unicode emoji characters, shipped as Vue 3 components",
  "main": "lib/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepack": "rm -rf lib && npm run build",
    "pack": "rm -rf dest && mkdir -p dest && npm pack --pack-destination=dest",
    "publish:npm": "bash ../bin/publish.sh",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=2048 npx jest --runInBand --logHeapUsage --detectOpenHandles --forceExit --errorOnDeprecated --coverage --silent --unhandled-rejections=strict"
  },
  "keywords": [
    "svg",
    "icons",
    "vue",
    "vue3",
    "unicode",
    "emoji"
  ],
  "author": "satoshi kotaki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwalletcorp/vue-svg-icons.git"
  },
  "homepage": "https://github.com/digitalwalletcorp/vue-svg-icons",
  "bugs": {
    "url": "https://github.com/digitalwalletcorp/vue-svg-icons/issues"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/server-renderer": "^3.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
